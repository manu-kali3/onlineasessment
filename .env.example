# Neon Postgres connection string
DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Session / JWT signing secret
AUTH_SECRET=replace-with-a-long-random-string

# Public URL of this app (used for ATS callbacks and candidate invite links)
# Emailed verification / reset links use this. If it is missing or points at
# localhost, the app falls back to VERCEL_URL and then the incoming Host header,
# so a forgotten value cannot produce dead localhost links in production.
NEXT_PUBLIC_APP_URL=https://onlineasessment.vercel.app

# Integrations
ATS_WEBHOOK_SECRET=replace-me
PROCTORING_WEBHOOK_SECRET=replace-me

# Resend (transactional email: verification + password reset)
# Without this the app still works — mail is logged to the console instead.
RESEND_API_KEY=re_your_key_here
RESEND_FROM=Assessment Center <onboarding@resend.dev>