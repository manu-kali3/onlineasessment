# Neon Postgres connection string
DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Session / JWT signing secret
AUTH_SECRET=replace-with-a-long-random-string

# Public URL of this app (used for ATS callbacks and candidate invite links)
# Emailed verification / reset links use this. If it is missing or points at
# localhost, the app falls back to VERCEL_URL and then the incoming Host header,
# so a forgotten value cannot produce dead localhost links in production.
NEXT_PUBLIC_APP_URL=https://onlineasessment.vercel.app

# Integrations
ATS_WEBHOOK_SECRET=replace-me
PROCTORING_WEBHOOK_SECRET=replace-me

# PayHero (M-Pesa payments for site access). Server-only.
# PAYHERO_CHANNEL_ID is the paybill/till that receives the money; without it
# checkout is hidden and the paywall says so rather than failing silently.
PAYHERO_USERNAME=
PAYHERO_PASSWORD=
PAYHERO_ACCOUNT_ID=
PAYHERO_AUTH_TOKEN=
PAYHERO_CHANNEL_ID=

# Set to 1 to work locally without paying. Ignored in production.
BYPASS_PAYWALL=0

# Resend (transactional email: verification + password reset)
# RESEND_FROM must be on a domain you have VERIFIED in the Resend dashboard.
# Do not use onboarding@resend.dev for real traffic: it is a test-only address
# restricted to the account owner and will not pass SPF/DKIM for candidates.
# Without RESEND_API_KEY the app still runs, but mail is only logged.
RESEND_API_KEY=re_your_key_here
RESEND_FROM=Assessment Center <no-reply@yourdomain.com>